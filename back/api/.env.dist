# Nomoni backend — local environment template.
# Copy this file without the .dist suffix and fill in your values.
# All values below are placeholders; real credentials must never be committed.

# Backend API
# JWT_SECRET must be at least 32 random bytes in production.
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:9000

# App DB URL — RUNTIME user, CRUD-only (no DDL: cannot create/alter/drop tables).
# The API uses this account for every request.
DATABASE_URL=postgresql+asyncpg://APP_USER:APP_PASSWORD@host.docker.internal:5432/nomoni

# Migration DB URL — DDL user (may CREATE/ALTER/DROP), used ONLY by Alembic
# (reads MIGRATION_DATABASE_URL first; falls back to DATABASE_URL if absent).
# Typical setup: same database, one user with DDL rights, one CRUD-only,
# and the DDL user runs the GRANTs after each migration.
MIGRATION_DATABASE_URL=postgresql+asyncpg://DDL_USER:DDL_PASSWORD@host.docker.internal:5432/nomoni
